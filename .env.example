# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=contraseña
POSTGRES_DB=marketing_db

# n8n
# IMPORTANTE: Genera N8N_ENCRYPTION_KEY con: openssl rand -hex 32
# Si pierdes esta key, pierdes acceso a todas las credenciales guardadas en workflows
N8N_ENCRYPTION_KEY=123456789
N8N_HOST=localhost:5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Mexico_City

# pgAdmin (opcional, solo si usas docker-compose.admin.yml)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=1234